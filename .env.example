# Copy to .env and fill in for local/mobile development. Client-safe values only
# (this file is bundled in mobile builds). Web builds do NOT ship it: they get
# these values via --dart-define (see scripts/render_build.sh).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
# Web map only. Register your site's domain for this key in Kakao Developers.
KAKAO_JAVASCRIPT_KEY=your-kakao-javascript-key

# Optional: https links to legal documents shown on the login screens
# TERMS_URL=https://example.com/terms
# PRIVACY_URL=https://example.com/privacy
